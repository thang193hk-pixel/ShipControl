# Copy this to .streamlit/secrets.toml (local) or paste into
# Streamlit Cloud -> App settings -> Secrets. NEVER commit the real file.
APP_URL = "https://your-app.streamlit.app"
ADMIN_PASSWORD = "choose-a-strong-password"   # only used when the admin account is first created
SMTP_EMAIL = "your_gmail@gmail.com"
SMTP_APP_PASSWORD = "xxxx xxxx xxxx xxxx"      # 16-char Google App Password
ADMIN_EMAIL = "your_gmail@gmail.com"
